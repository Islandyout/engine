{
  "name": "game-engine-editor",
  "version": "0.82.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "fps": "tsx ../../tools/fps/build_last_signal.ts",
    "racing": "tsx ../../tools/racing/build_high_heat.ts",
    "space": "tsx ../../tools/space/build_pale_signal.ts",
    "gatebreaker": "tsx ../../tools/gatebreaker/build_m0.ts && tsx ../../tools/gatebreaker/build_game.ts"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "tsx": "4.20.5"
  }
}
