    {
      "name": "Adam",
      "components": {
        "Transform": {
          "position": {
            "x": -1,
            "y": -0.4786155462265015,
            "z": 0
          }
        },
        "Rotation": {
          "euler": {
            "x": 0,
            "y": 1.5707963267948966,
            "z": 0
          }
        },
        "Renderable": {
          "mesh": 249,
          "material": 0,
          "visible": true
        },
        "RigidBody": {
          "mass": 70,
          "inverseMass": 1,
          "dynamic": true
        },
        "Collider": {
          "type": "AABB",
          "halfExtents": {
            "x": 0.5,
            "y": 0.5,
            "z": 0.5
          },
          "radius": 0.5,
          "isTrigger": false,
          "layer": 0,
          "mask": 4294967295,
          "bounciness": 0
        },
        "Script": {
          "source": "-- Driven entirely by edenAgents.ts (TS), which runs the person's mind\n-- (src/eden/mind.ts) and broadcasts a new target via\n-- editor_ui_event(\"eden_target_adam\", \"x,y,z,action,speed\") whenever the mind\n-- decides something new. This script only\n-- ever walks toward the last target it was given and plays that action's\n-- clip on arrival -- it has no say in WHAT Adam does, only HOW he gets\n-- there. The sandboxed Lua VM has no network access at all by design (see\n-- source/engine/script/script.cpp's open_sandboxed_libs), so the decision\n-- itself can only ever be made outside it.\n\n-- \"Man (casual)\" (catalog id 249) carries its own clips (idle/talk/run/\n-- walk/Wave/Death/HitRecieve) -- already a clothed, fully-animated model,\n-- so there's no outfit to dress (unlike the clip-less UBC base bodies).\n\nlocal target = nil -- {x, y, z, action}\nlocal waypoints = nil\nlocal wpIndex = 1\nlocal arrived = true\nlocal playedAction = nil\nlocal WALK_SPEED = 1.6\n\nlocal function parse_target(value)\n  local parts = {}\n  for p in string.gmatch(value, \"[^,]+\") do parts[#parts + 1] = p end\n  if #parts < 4 then return nil end\n  return { x = tonumber(parts[1]), y = tonumber(parts[2]), z = tonumber(parts[3]), action = parts[4], speed = tonumber(parts[5]) }\nend\n\nfunction on_ui(name, value)\n  if name ~= \"eden_target_adam\" then return end\n  local t = parse_target(value)\n  if not t then return end\n  target = t\n  waypoints = world.path(self.x, self.y, self.z, t.x, t.y, t.z)\n  -- No route found (the path grid does not cover open terrain): walk straight at the target and let physics steer round what is in the way.\n  if not waypoints or #waypoints == 0 then waypoints = { { x = t.x, y = t.y, z = t.z } } end\n  wpIndex = 1\n  arrived = false\nend\n\nlocal function play(action)\n  if playedAction ~= action then\n    self.animate = action\n    playedAction = action\n  end\nend\n\nfunction on_tick(dt)\n  if not target then return end\n  if arrived then\n    self.vx, self.vz = 0, 0\n    play(target.action)\n    return\n  end\n  if not waypoints or #waypoints == 0 then\n    -- Unreachable (world.path found nothing, or start == target): stand\n    -- and play the action anyway rather than getting stuck on nothing.\n    arrived = true\n    return\n  end\n  local wp = waypoints[wpIndex]\n  local dx, dz = wp.x - self.x, wp.z - self.z\n  local dist = math.sqrt(dx * dx + dz * dz)\n  if dist < 0.3 then\n    wpIndex = wpIndex + 1\n    if wpIndex > #waypoints then\n      arrived = true\n      self.vx, self.vz = 0, 0\n      play(target.action)\n      return\n    end\n  else\n    self.vx = (dx / dist) * (target.speed or WALK_SPEED)\n    self.vz = (dz / dist) * (target.speed or WALK_SPEED)\n    play((target.speed or WALK_SPEED) > 3 and \"run\" or \"walk\")\n  end\nend\n",
          "props": {}
        }
      }
    },
